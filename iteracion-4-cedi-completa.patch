+{% extends 'base.html' %}
+
+{% block title %}CEDI · Pedidos de tiendas{% endblock %}
+
+{% block content %}
+<div class="page-header d-print-none">
+    <h2 class="page-title">Pedidos de tiendas</h2>
+    <div class="text-muted mt-1">Pedidos aprobados por los gerentes, en orden de llegada.</div>
+</div>
+
+<div class="row row-deck row-cards mt-3">
+    <div class="col-sm-6 col-lg-3">
+        <a href="?estado=AP" class="card card-link text-reset"><div class="card-body">
+            <div class="subheader">Por despachar</div>
+            <div class="h1 mb-0">{{ kpi.por_despachar }}</div>
+        </div></a>
+    </div>
+    <div class="col-sm-6 col-lg-3">
+        <a href="?estado=DE" class="card card-link text-reset"><div class="card-body">
+            <div class="subheader">En tránsito</div>
+            <div class="h1 mb-0 text-azure">{{ kpi.en_transito }}</div>
+        </div></a>
+    </div>
+    <div class="col-sm-6 col-lg-3">
+        <div class="card"><div class="card-body">
+            <div class="subheader">Despachados hoy</div>
+            <div class="h1 mb-0 text-green">{{ kpi.despachados_hoy }}</div>
+        </div></div>
+    </div>
+    <div class="col-sm-6 col-lg-3">
+        <a href="?estado=RC" class="card card-link text-reset"><div class="card-body">
+            <div class="subheader">Rechazados</div>
+            <div class="h1 mb-0 {% if kpi.rechazados %}text-red{% endif %}">{{ kpi.rechazados }}</div>
+        </div></a>
+    </div>
+</div>
+
+<div class="card mt-3">
+    <div class="card-header">
+        <form method="get" class="d-flex flex-wrap gap-2 w-100">
+            <select name="estado" class="form-select w-auto" onchange="this.form.submit()">
+                {% for clave, nombre in estados.items %}
+                    <option value="{{ clave }}" {% if clave == estado %}selected{% endif %}>{{ nombre }}</option>
+                {% endfor %}
+            </select>
+            <select name="tienda" class="form-select w-auto" onchange="this.form.submit()">
+                <option value="">Todas las tiendas</option>
+                {% for t in tiendas %}
+                    <option value="{{ t.pk }}" {% if tienda_id == t.pk|stringformat:"s" %}selected{% endif %}>{{ t.nombre }}</option>
+                {% endfor %}
+            </select>
+        </form>
+    </div>
+    {% if pedidos %}
+    <div class="table-responsive">
+        <table class="table table-vcenter card-table table-hover">
+            <thead>
+                <tr>
+                    <th>Pedido</th>
+                    <th>Tienda</th>
+                    <th>Aprobado</th>
+                    <th class="text-end">Productos</th>
+                    <th class="text-end">Unidades pedidas</th>
+                    <th>Estado</th>
+                    <th></th>
+                </tr>
+            </thead>
+            <tbody>
+                {% for p in pedidos %}
+                <tr>
+                    <td>#{{ p.pk }}</td>
+                    <td>
+                        <div>{{ p.tienda.nombre }}</div>
+                        <div class="text-muted small">{{ p.tienda.codigo_sucursal }}</div>
+                    </td>
+                    <td>
+                        <div>{{ p.fecha_aprobacion|date:"d/m/Y H:i" }}</div>
+                        {% if p.estatus == 'AP' and p.fecha_aprobacion %}
+                            <div class="text-muted small">hace {{ p.fecha_aprobacion|timesince:ahora }}</div>
+                        {% endif %}
+                    </td>
+                    <td class="text-end">{{ p.lineas }}</td>
+                    <td class="text-end">{{ p.unidades|default:0 }}</td>
+                    <td>
+                        {% if p.estatus == 'AP' %}<span class="badge bg-yellow text-dark">Por despachar</span>
+                        {% elif p.estatus == 'DE' %}<span class="badge bg-azure text-white">En tránsito</span>
+                        {% elif p.estatus == 'RE' %}<span class="badge bg-green text-white">Recibido</span>
+                        {% elif p.estatus == 'RC' %}<span class="badge bg-red text-white">Rechazado</span>
+                        {% endif %}
+                    </td>
+                    <td class="text-end">
+                        {% if p.estatus == 'AP' %}
+                            <a href="{% url 'cedi_pedido' p.pk %}" class="btn btn-primary btn-sm">Preparar despacho</a>
+                        {% else %}
+                            <a href="{% url 'cedi_pedido' p.pk %}" class="btn btn-outline-primary btn-sm">Ver detalle</a>
+                        {% endif %}
+                    </td>
+                </tr>
+                {% endfor %}
+            </tbody>
+        </table>
+    </div>
+    {% else %}
