+    <script>
+    // Resalta en el menú lateral la sección en la que está el usuario
+    document.addEventListener('DOMContentLoaded', function () {
+        const ruta = window.location.pathname;
+        let mejor = null;
+        document.querySelectorAll('.navbar-vertical .navbar-nav a[href]').forEach(function (a) {
+            const href = a.getAttribute('href');
+            if (!href || href === '#' || href.startsWith('#')) return;
+            const coincide = href === '/' ? ruta === '/' : ruta.startsWith(href);
+            if (coincide && (!mejor || href.length > mejor.getAttribute('href').length)) mejor = a;
+        });
+        if (!mejor) return;
+        mejor.classList.add('active');
+        const grupo = mejor.closest('.nav-item');
+        if (grupo) grupo.classList.add('active');
+    });
+    </script>
 </body>
 </html>
 
