From d302e250a87ba7fea5da29ab38ee43627bea9e80 Mon Sep 17 00:00:00 2001
From: Claude <noreply@anthropic.com>
Date: Sat, 7 Nov 2026 12:30:48 +0000
Subject: [PATCH 2/2] Distintivos legibles: texto con contraste sobre los
 fondos de color (Bootstrap 5.3)

---
 static/css/granja.css | 11 +++++++++++
 1 file changed, 11 insertions(+)

diff --git a/static/css/granja.css b/static/css/granja.css
index 286ed7f..0bc8ec4 100644
--- a/static/css/granja.css
+++ b/static/css/granja.css
@@ -243,3 +243,14 @@ h1, h2, h3,
 @media (prefers-reduced-motion: reduce) {
     * { transition: none !important; }
 }
+
+/* ---------- Distintivos (badges) legibles ----------
+   Desde Bootstrap 5.3, .bg-* solo pinta el fondo y no ajusta el texto:
+   sin esta regla, el número de un distintivo rojo quedaba en rojo sobre rojo. */
+.badge.bg-danger, .badge.bg-red, .badge.bg-success, .badge.bg-green,
+.badge.bg-info, .badge.bg-azure, .badge.bg-blue, .badge.bg-secondary, .badge.bg-dark {
+    color: #fff;
+}
+.badge.bg-primary, .badge.bg-warning, .badge.bg-yellow {
+    color: var(--granja-berenjena);
+}
-- 
