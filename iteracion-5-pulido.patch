+/* ---------- Barra superior con la franja de colores del logo ---------- */
+.main-header, .app-header { position: relative; border-bottom: 0 !important; }
+.main-header::after, .app-header::after {
+    content: ""; position: absolute; left: 0; right: 0; bottom: 0; height: 3px;
+    background: linear-gradient(90deg, var(--granja-rojo) 0 25%, var(--granja-azul) 25% 50%,
+                var(--granja-amarillo) 50% 75%, var(--granja-magenta) 75% 100%);
+}
+
+/* ---------- Botones, tarjetas y tablas ---------- */
+.btn-primary, .btn-success {
+    background: var(--granja-amarillo) !important; border-color: var(--granja-amarillo) !important;
+    color: var(--granja-berenjena) !important; font-weight: 700;
+}
+.btn-primary:hover, .btn-success:hover { background: var(--granja-amarillo-hover) !important; border-color: var(--granja-amarillo-hover) !important; }
+.btn-outline-primary { color: var(--granja-berenjena) !important; border-color: var(--granja-amarillo) !important; }
+.btn-outline-primary:hover { background: var(--granja-amarillo) !important; }
+.card { border-radius: 12px; border: 1px solid var(--granja-linea); box-shadow: none; }
+.card-primary.card-outline, .card-warning.card-outline { border-top: 3px solid var(--granja-amarillo) !important; }
+.table thead th { background: #FAF9FB; color: #6B6475; font-weight: 700; border-bottom-width: 1px; }
+.page-item.active .page-link { background: var(--granja-amarillo); border-color: var(--granja-amarillo); color: var(--granja-berenjena); }
+.form-control:focus, .custom-select:focus, .select2-container--focus .select2-selection {
