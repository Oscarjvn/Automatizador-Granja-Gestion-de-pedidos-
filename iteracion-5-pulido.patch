+
+/* ---------- Pantalla de inicio de sesión del admin ---------- */
+body.login-page { background: var(--granja-berenjena) !important; }
+.login-page .login-logo img, .login-logo img {
+    max-height: 110px !important; width: auto !important; display: block; margin: 0 auto 1rem;
+}
+.login-page .login-logo a, .login-page .login-logo { color: #fff !important; }
+.login-page .card { border-radius: 16px; border: 0; }
+.login-page .login-box-msg { color: #6B6475; }
+/* Jazzmin incluye el logo en versión clara y oscura: solo se muestra la del tema activo */
+.login-logo .logo-dark { display: none !important; }
+[data-bs-theme="dark"] .login-logo .logo-dark { display: block !important; }
+[data-bs-theme="dark"] .login-logo .logo-light { display: none !important; }
