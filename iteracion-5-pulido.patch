+.sidebar .nav-link, .app-sidebar .nav-link { color: rgba(255, 255, 255, .72) !important; border-left: 3px solid transparent; border-radius: 0 !important; }
+.sidebar .nav-link:hover, .app-sidebar .nav-link:hover { color: #fff !important; background: rgba(255, 255, 255, .06) !important; }
+.sidebar .nav-link.active, .sidebar .nav-item.menu-open > .nav-link,
